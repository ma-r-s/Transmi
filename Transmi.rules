
(rules PCB Transmi.dsn
  (snap_angle 
    fortyfive_degree
  )
  (autoroute_settings
    (fanout off)
    (autoroute on)
    (postroute on)
    (vias on)
    (via_costs 5)
    (plane_via_costs 5)
    (start_ripup_costs 100)
    (start_pass_no 1)
    (layer_rule F.Cu
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 1.1)
    )
    (layer_rule B.Cu
      (active on)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 1.1)
    )
  )
  (rule
    (width 200.0)
    (clearance 100.0)
    (clearance 100.0 (type smd_to_turn_gap))
    (clearance 25.0 (type smd))
    (clearance 100.0 (type "kicad_default"))
  )
  (padstack "Via[0-1]_600:300_um"
    (shape
      (circle F.Cu 600.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 600.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-1]_600:300_um" "Via[0-1]_600:300_um" default
  )
  (via 
    "Via[0-1]_600:300_um-kicad_default" "Via[0-1]_600:300_um" "kicad_default"
  )
  (via_rule
    default "Via[0-1]_600:300_um"
  )
  (via_rule
    "kicad_default" "Via[0-1]_600:300_um-kicad_default"
  )
  (class default
    (clearance_class default)
    (via_rule default)
    (rule
      (width 200.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class "kicad_default"
    +BATT Earth "XTAL_N" +5V +3V3 "Net-(C110-Pad1)" "Net-(U1-XTAL_32K_P)" "Net-(U1-XTAL_32K_N)"
    RESET VBUS "Net-(D129-K)" "Net-(D130-K)" BOOT CHRG STBY "Net-(U103-PROG)"
    VCC "Net-(Q102-CE)" "XTAL_P" "Net-(USB101-CC1)" "Net-(USB101-CC2)" VBAT "unconnected-(U1-MTCK-Pad43)" "unconnected-(U1-GPIO35-Pad39)"
    "unconnected-(U1-GPIO14-Pad19)" "unconnected-(U1-GPIO37-Pad41)" "USB_DP" "unconnected-(U1-MTMS-Pad47)" "USB_DN" "unconnected-(U1-GPIO3-Pad8)" "unconnected-(U1-GPIO34-Pad38)" "unconnected-(U1-GPIO8-Pad13)"
    "unconnected-(U1-GPIO5-Pad10)" "unconnected-(U1-MTDO-Pad44)" "unconnected-(U1-GPIO45-Pad50)" "unconnected-(U1-GPIO1-Pad6)" "unconnected-(U1-GPIO10-Pad15)" "unconnected-(U1-GPIO13-Pad18)" "unconnected-(U1-SPIHD-Pad31)" "unconnected-(U1-MTDI-Pad46)"
    "unconnected-(U1-GPIO21-Pad28)" "unconnected-(U1-SPIQ-Pad35)" "unconnected-(U1-DAC_2-Pad24)" "unconnected-(U1-GPIO2-Pad7)" "unconnected-(U1-SPICLK-Pad34)" "unconnected-(U1-SPIWP-Pad32)" "unconnected-(U1-SPID-Pad36)" "unconnected-(U1-SPICS1-Pad29)"
    "unconnected-(U1-U0RXD-Pad49)" "unconnected-(U1-GPIO36-Pad40)" "unconnected-(U1-GPIO9-Pad14)" "unconnected-(U1-GPIO12-Pad17)" "Net-(J104-Pin_1)" "unconnected-(U1-DAC_1-Pad23)" "unconnected-(U1-SPICS0-Pad33)" "unconnected-(U1-GPIO7-Pad12)"
